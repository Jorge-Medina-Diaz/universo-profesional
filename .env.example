# =============================================================================
# Universo Profesional — environment configuration
#
# Copy this to `.env` and fill in. Values shown are dev defaults; ⚠️ flags
# what MUST be set explicitly in production. See `docs/OPERATIONS/DEPLOYMENT.md`
# for a step-by-step setup guide.
# =============================================================================

# ----- Runtime -------------------------------------------------------------
# Number of gunicorn + uvicorn workers (production only).
# WEB_CONCURRENCY=2
# `development` | `test` | `production` — controls strict validation and which
# providers fall back to mocks vs real services.
ENV=development

# ----- Database (Postgres + asyncpg) --------------------------------------
# ⚠️ Override in production.
DATABASE_URL=postgresql+asyncpg://cvs:cvs_dev_password@localhost:5432/cvs
DATABASE_URL_SYNC=postgresql://cvs:cvs_dev_password@localhost:5432/cvs
DATABASE_ECHO=false

# ----- Redis (Arq queue + rate-limit storage) -----------------------------
# ⚠️ Override in production.
REDIS_URL=redis://localhost:6379/0

# ----- URLs (canonical = backend public URL; frontend = SPA URL) ----------
# ⚠️ Override in production with real https:// URLs.
CANONICAL_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# ----- CORS ----------------------------------------------------------------
# JSON array of allowed origins. ⚠️ Production MUST set this to the frontend
# origin(s) without including localhost.
# Examples:
#   CORS_ORIGINS=["http://localhost:5173"]
#   CORS_ORIGINS=["https://app.universo.pro","https://www.universo.pro"]
CORS_ORIGINS=["http://localhost:5173"]

# ----- Email --------------------------------------------------------------
# `mock` | `brevo` | `postmark`. ⚠️ Production MUST be `brevo` or `postmark`.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@cvs-saas.local
EMAIL_FROM_NAME=Universo Profesional
EMAIL_HOST=localhost
EMAIL_PORT=1025
# Required when EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# Required when EMAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=

# ----- LLM providers -------------------------------------------------------
# `mock` | `anthropic` | `openai`. ⚠️ Production MUST set ANTHROPIC_API_KEY
# (preferred) or OPENAI_API_KEY.
# Backend-wide LLM provider (used by document generation and some fallback paths).
LLM_PROVIDER=mock
AGENTS_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
AGENTS_COORDINATOR_MODEL=claude-sonnet-4-6
AGENTS_SPECIALIST_MODEL=claude-haiku-4-5-20251001

# ----- Embeddings ---------------------------------------------------------
# `deterministic` | `openai` | `mistral`. Deterministic is fine for prod if
# you don't have an embeddings provider configured.
EMBEDDINGS_PROVIDER=deterministic

# ----- Stripe (billing) ---------------------------------------------------
# `mock` | `real`. ⚠️ Production with paid plans MUST be `real`.
STRIPE_PROVIDER=mock
# Required when STRIPE_PROVIDER=real:
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_SUCCESS_URL=https://app.universo.pro/billing?success=1
# STRIPE_CANCEL_URL=https://app.universo.pro/billing?cancelled=1

# ----- Token encryption (Fernet) ------------------------------------------
# ⚠️ REQUIRED in production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# ----- JWT signing keys ---------------------------------------------------
# RSA 2048. Generated on first run into the volume at these paths. In prod
# mount a persistent volume here so the keys survive container restarts.
JWT_PRIVATE_KEY_PATH=/app/var/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/var/keys/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ----- OAuth integrations (GitHub / LinkedIn) -----------------------------
# Optional but encourged for the import flows.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
LINKEDIN_DMA_ENABLED=false

# ----- Bright Data (LinkedIn scraping, PRO tier) --------------------------
# BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=gd_l1viktl72bvl7bjuj0

# ----- Storage ------------------------------------------------------------
# `filesystem` | `s3`. In production prefer `s3` (or S3-compatible like R2).
STORAGE_PROVIDER=filesystem
STORAGE_ROOT=/app/var/documents

# ----- Observability -----------------------------------------------------
# OpenTelemetry OTLP endpoint (e.g. http://otel-collector:4317). Leave empty to disable.
# OTLP_ENDPOINT=
# Sentry DSN for error tracking.
# SENTRY_DSN=
LOG_LEVEL=INFO
# Optional. Recommended in production.
# SENTRY_DSN=

# ----- Auth flow toggles --------------------------------------------------
# Skip email verification in dev. ⚠️ NEVER true in production.
AUTO_VERIFY_EMAILS_IN_DEV=false

# ----- Rate limiting ------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Falls back to REDIS_URL when empty.
# RATE_LIMIT_STORAGE_URI=

# ----- MCP rate limiting --------------------------------------------------
MCP_RATE_LIMIT_PER_MINUTE=100
MCP_RATE_LIMIT_PER_HOUR=1000
MCP_RATE_LIMIT_PER_DAY=10000

# ----- ESCO ontology seeding -----------------------------------------------
# Auto-seed ESCO on startup in development (non-blocking background task).
AUTO_SEED_ESCO=true
# Release tag stored in graph_ingest_meta. Defaults to content hash.
# ESCO_VERSION=v1.1.1
# Override the default EU download URL. Leave empty to use bundled sample.
# ESCO_DOWNLOAD_URL=

# ----- Quotas (free tier) -------------------------------------------------
FREE_CV_PER_MONTH=3
FREE_COVER_LETTERS_PER_MONTH=1

# =============================================================================
# Frontend env (Vite — prefix VITE_ to expose to the browser).
# Set these on the frontend deployment target.
# =============================================================================
# VITE_API_BASE_URL=https://api.universo.pro
# VITE_SENTRY_DSN=
# VITE_AGUI_URL=  # only override if backend AG-UI is on a different domain
