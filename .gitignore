# Logs
*.log
logs/

# Local data
var/
data/
.local/
# ...but the bundled ESCO sample is source, not local data. It has to be a
# negation on the DIRECTORY: git cannot re-include a file whose parent dir is
# excluded, so `!backend/data/esco_sample/` alone would not work. Without this
# the seed step finds no CSVs, ingests zero rows and reports success.
!backend/data/

# Docker volumes (when bind-mounted)
docker-data/

# Tooling / agent / test artifacts (never commit)
.claude/
.playwright-mcp/
backups/

# Root-level accidental artifacts (frontend has its own manifests)
/package.json
/package-lock.json
/*.png
backend/.cache/
backend/nul
# Screenshots dropped at repo root during UI testing
/*.png

# Secrets / keys
*.pem
*.key
*.crt
secrets/

# Test artifacts
playwright-report/
test-results/

