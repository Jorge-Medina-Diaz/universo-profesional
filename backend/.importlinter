[importlinter]
root_packages =
    src

[importlinter:contract:layered]
name = Clean architecture layering
type = layers
layers =
    interfaces
    infrastructure
    application
    domain
containers =
    src.identity
    src.universe
    src.documents
    src.billing
    src.mcp_server
    src.coherence
    src.graph
    src.agents
    src.knowledge
    src.notes
    src.rubrics
    src.integrations
    src.llm_tracking
