# =============================================================================
# Universo Profesional — Frontend environment
#
# Copy this to `.env` and fill in. These are Vite env vars (prefix VITE_)
# exposed to the browser. NEVER put secrets here — they become public.
# =============================================================================

# ----- API base URL ---------------------------------------------------------
# The backend URL that the frontend SPA calls.
VITE_API_BASE_URL=http://localhost:8000

# ----- Error tracking --------------------------------------------------------
# Optional. Sentry DSN for the frontend (public, browser-safe).
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
